import { useState } from "react";
import { apiRequest } from "../api/client";
import { useAuth } from "../context/AuthContext";

function RoleIcon({ type }) {
  if (type === "owner") {
    return (
      <svg className="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round">
        <path d="M3 9l1.5-5h15L21 9" />
        <path d="M4 9h16v10a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9z" />
        <path d="M9 20v-6h6v6" />
      </svg>
    );
  }
  if (type === "customer") {
    return (
      <svg className="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round">
        <circle cx="12" cy="7" r="3.5" />
        <path d="M5 20a7 7 0 0 1 14 0" />
        <path d="M16.5 14.5l2-2 1.5 1.5-2 2z" />
      </svg>
    );
  }
  return (
    <svg className="w-7 h-7 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.9" strokeLinecap="round" strokeLinejoin="round">
      <path d="M6 13.5a4.5 4.5 0 0 1 1.2-8.8 5.2 5.2 0 0 1 9.6 0A4.5 4.5 0 0 1 18 13.5" />
      <path d="M7.5 13.5v5.5h9v-5.5" />
      <path d="M7.5 16.5h9" />
    </svg>
  );
}

const ROLES = [
  {
    id: "owner",
    title: "Cafe Holder",
    subtitle: "Select Role to Proceed.",
    badge: "Active",
    dotClass: "bg-emerald-400",
    defaultUser: "owner",
    defaultPass: "owner123",
  },
  {
    id: "customer",
    title: "Customer",
    subtitle: "Select Role to Proceed.",
    badge: "Dine-in",
    dotClass: "bg-amber-400",
    defaultUser: "customer",
    defaultPass: "",
  },
  {
    id: "kitchen",
    title: "Kitchen Staff",
    subtitle: "Select Role to Proceed.",
    badge: "KDS",
    dotClass: "bg-amber-300",
    defaultUser: "kitchen",
    defaultPass: "kitchen123",
  },
];

export default function LoginPage({ onSuccess }) {
  const { loginUser } = useAuth();
  const [selectedRole, setSelectedRole] = useState("owner");
  const [username, setUsername] = useState("owner");
  const [password, setPassword] = useState("owner123");
  const [tableNo, setTableNo] = useState("Table 04");
  const [showPass, setShowPass] = useState(false);
  const [error, setError] = useState("");
  const [loading, setLoading] = useState(false);

  const handleSelectRole = (roleObj) => {
    setSelectedRole(roleObj.id);
    setUsername(roleObj.defaultUser);
    setPassword(roleObj.defaultPass);
    setError("");
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError("");
    setLoading(true);
    try {
      const bodyPayload =
        selectedRole === "customer"
          ? {
              username: (username || "Customer").trim(),
              role: "customer",
              table_no: (tableNo || "").trim(),
            }
          : {
              username: username.trim(),
              password,
              role: selectedRole,
            };

      const data = await apiRequest("/api/auth/login", {
        method: "POST",
        body: JSON.stringify(bodyPayload),
      });

      loginUser(data.user);
      if (onSuccess) onSuccess(data.user.role);
    } catch (err) {
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="max-w-6xl mx-auto py-3">
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
        <div className="lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
          {ROLES.map((r) => {
            const active = selectedRole === r.id;
            return (
              <button
                key={r.id}
                type="button"
                onClick={() => handleSelectRole(r)}
                style={{
                  boxShadow: active
                    ? "0 0 28px rgba(245, 158, 11, 0.28), inset 0 0 14px rgba(245, 158, 11, 0.08)"
                    : "0 0 18px rgba(245, 158, 11, 0.12)",
                }}
                className={
                  active
                    ? "relative flex flex-col items-center justify-center text-center rounded-3xl p-6 bg-[#1e2430] border-2 border-amber-400 transition-all duration-200 min-h-[280px]"
                    : "relative flex flex-col items-center justify-center text-center rounded-3xl p-6 bg-[#1b202b] border border-amber-400/50 hover:border-amber-300 transition-all duration-200 min-h-[280px]"
                }
              >
                <span className="absolute top-4 right-4 inline-flex items-center gap-1.5 text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-slate-800/90 text-slate-200 border border-slate-700/80">
                  {r.badge}
                  <span className={"w-2 h-2 rounded-full " + r.dotClass} />
                </span>

                <div
                  style={{ boxShadow: "0 0 16px rgba(245, 158, 11, 0.22)" }}
                  className="w-16 h-16 rounded-full bg-amber-500/15 border border-amber-400/55 flex items-center justify-center mb-4"
                >
                  <RoleIcon type={r.id} />
                </div>

                <h3 className="text-lg font-bold text-white">{r.title}</h3>
                <p className="text-xs text-slate-300/80 mt-1.5">{r.subtitle}</p>
              </button>
            );
          })}
        </div>

        <form
          onSubmit={handleSubmit}
          style={{
            boxShadow: "0 0 28px rgba(245, 158, 11, 0.22), inset 0 0 12px rgba(245, 158, 11, 0.06)",
          }}
          className="lg:col-span-4 bg-[#1e2430] border border-amber-400/65 rounded-3xl p-6 flex flex-col justify-between space-y-4"
        >
          <div className="space-y-4">
            <div className="flex items-center justify-between gap-2">
              <h2 className="text-xl font-bold text-white">Welcome Back</h2>
              <span className="text-[11px] font-semibold px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-400/40">
                {ROLES.find((x) => x.id === selectedRole)?.title}
              </span>
            </div>

            {error && (
              <div className="text-xs text-rose-200 bg-rose-950/70 border border-rose-700 rounded-2xl p-3">
                {error}
              </div>
            )}

            <div>
              <label className="block text-xs text-slate-300 mb-1.5">
                {selectedRole === "customer" ? "Customer Name" : "Username / Email"}
              </label>
              <input
                className="w-full bg-[#151922] border border-amber-400/45 focus:border-amber-300 outline-none rounded-2xl px-4 py-2.5 text-sm text-white placeholder:text-slate-500"
                value={username}
                onChange={(e) => setUsername(e.target.value)}
                required
              />
            </div>

            {selectedRole === "customer" ? (
              <div>
                <label className="block text-xs text-slate-300 mb-1.5">Table Number</label>
                <input
                  className="w-full bg-[#151922] border border-amber-400/45 focus:border-amber-300 outline-none rounded-2xl px-4 py-2.5 text-sm text-white placeholder:text-slate-500"
                  value={tableNo}
                  onChange={(e) => setTableNo(e.target.value)}
                  placeholder="Table 04"
                />
              </div>
            ) : (
              <div>
                <label className="block text-xs text-slate-300 mb-1.5">Password</label>
                <div className="relative">
                  <input
                    type={showPass ? "text" : "password"}
                    className="w-full bg-[#151922] border border-amber-400/45 focus:border-amber-300 outline-none rounded-2xl px-4 py-2.5 pr-16 text-sm text-white placeholder:text-slate-500"
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    required
                  />
                  <button
                    type="button"
                    onClick={() => setShowPass((p) => !p)}
                    className="absolute right-3.5 top-1/2 -translate-y-1/2 text-xs text-amber-300 hover:text-amber-200 font-semibold"
                  >
                    {showPass ? "Hide" : "Show"}
                  </button>
                </div>
              </div>
            )}
          </div>

          <div className="space-y-3 pt-2">
            <button
              type="submit"
              disabled={loading}
              style={{ boxShadow: "0 0 18px rgba(245, 158, 11, 0.35)" }}
              className="w-full bg-gradient-to-r from-amber-300 to-amber-500 hover:from-amber-200 hover:to-amber-400 text-slate-950 font-extrabold py-2.5 rounded-full text-sm transition"
            >
              {loading ? "Signing in..." : "Login"}
            </button>
            <p className="text-center text-xs text-slate-300/80">
              Demo:{" "}
              <span className="text-amber-300 font-medium">
                owner / owner123 • kitchen / kitchen123
              </span>
            </p>
          </div>
        </form>
      </div>
    </div>
  );
}